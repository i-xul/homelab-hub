[Unit]
Description=HomeLab Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hmasi
Group=hmasi
WorkingDirectory=/home/hmasi/homelab-hub/backend

ExecStart=/home/hmasi/homelab-hub/.venv/bin/gunicorn \
    --workers 1 \
    --bind 0.0.0.0:5000 \
    --access-logfile - \
    --error-logfile - \
    service:app

Restart=on-failure
RestartSec=5
TimeoutStopSec=150

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target